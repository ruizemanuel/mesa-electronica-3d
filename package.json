{
  "name": "simready-electronics-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets:fetch": "node tools/py.mjs tools/fetch_assets.py",
    "assets:convert": "node tools/py.mjs tools/usd_to_glb.py",
    "record": "node tools/record-showcase.mjs",
    "record:preview": "node tools/record-showcase.mjs --preview",
    "assets:optimize": "node tools/optimize_models.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@types/three": "^0.187.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "description": "Mesa de electrónica 3D en el navegador: multímetro, fuente y protoboard con física real, sobre assets OpenUSD de NVIDIA SimReady."
}
